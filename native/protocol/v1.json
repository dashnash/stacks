{
  "$comment": "The web <-> native bridge, protocol 1 (docs/NATIVE_APP_SPEC.md). Read by packages/native tests and native/ios tests: change both together.",
  "protocol": 1,
  "global": {
    "name": "stacksNative",
    "example": { "protocol": 1, "platform": "ios", "version": "1.0.0", "calls": ["app.info", "auth.google", "auth.signedOut", "share"] }
  },
  "envelope": {
    "request": { "v": 1, "name": "share", "args": { "url": "https://hello.iamdashnash.com/" } },
    "ok": { "ok": true, "result": { "completed": true } },
    "error": { "ok": false, "error": { "code": "cancelled", "message": "Share was cancelled" } }
  },
  "errorCodes": ["unsupported", "forbidden", "cancelled", "failed"],
  "calls": {
    "app.info": {
      "doc": "The app's version, build and platform.",
      "origins": "any",
      "args": {},
      "result": { "version": "1.0.0", "build": "42", "platform": "ios", "protocol": 1 }
    },
    "auth.google": {
      "doc": "Native Google sign-in. The ID token is addressed to the web client (serverClientID). Only the portal's own page may ask.",
      "origins": "auth",
      "args": {},
      "result": { "credential": "eyJhbGciOiJSUzI1NiJ9.e30.sig" }
    },
    "auth.signedOut": {
      "doc": "The person signed out everywhere: the app forgets its Google session (and, from N3, this device's push registration).",
      "origins": "auth",
      "args": {},
      "result": {}
    },
    "share": {
      "doc": "The system share sheet.",
      "origins": "any",
      "args": { "url": "https://hello.iamdashnash.com/", "text": "Come say hi", "title": "Hello Board" },
      "result": { "completed": true }
    }
  }
}
