{
  "name": "stacks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/modules/*",
    "platform/*",
    "apps/*",
    "tools/*",
    "infra"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "node scripts/check-imports.mjs",
    "synth": "npm run synth -w infra",
    "build": "npm run build --workspaces --if-present",
    "new-app": "npm run new-app -w tools/new-app --",
    "verify-app": "npm run verify-app -w tools/new-app --",
    "app-usage": "npm run app-usage -w tools/new-app --",
    "table-copy": "npm run table-copy -w tools/table-copy --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "@stacks/infra": "*"
  }
}
